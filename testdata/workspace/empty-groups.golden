# NAME: 只有一个节点
# TARGET: mihomo · mihomo 1.19.33
# GENERATOR: Clash, Launch! 1.0.0-dev · https://github.com/angwz/clash-launch
# UPDATED: 2026-11-09 08:00:00 (UTC+8)

mixed-port: 7890

proxies:
  - name: 🎐 自建 VPS
    type: wireguard
    server: 192.0.2.20
    port: 51820
    ip: 172.16.0.2
    public-key: QD8+PTw7Ojk4NzY1NDMyMTAvLi0sKyopKCcmJSQjIiE=
    private-key: AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=
    udp: true

proxy-groups:
  - name: 🌠 节点选择
    type: select
    proxies:
      - ✈️ 手动切换
      - DIRECT

  - name: ✈️ 手动切换
    type: select
    proxies:
      - 🎐 自建 VPS

  - name: 🗨️ ChatGPT
    type: select
    proxies:
      - ✈️ 手动切换

  - name: 📺 哔哩哔哩
    type: select
    proxies:
      - DIRECT
      - ✈️ 手动切换

  - name: 🍎 Apple
    type: select
    proxies:
      - DIRECT
      - 🌠 节点选择

  - name: 📱 TikTok
    type: select
    proxies:
      - ✈️ 手动切换

  - name: 🛸 Telegram
    type: select
    proxies:
      - 🌠 节点选择
      - ✈️ 手动切换

  - name: 💻 YouTube
    type: select
    proxies:
      - 🌠 节点选择
      - ✈️ 手动切换

  - name: 📩 Google
    type: select
    proxies:
      - 🌠 节点选择
      - 🗨️ ChatGPT
      - ✈️ 手动切换

  - name: 🏖️ Community
    type: select
    proxies:
      - 🌠 节点选择
      - ✈️ 手动切换

  - name: ⛅ OneDrive
    type: select
    proxies:
      - 🌠 节点选择
      - DIRECT

  - name: 🎬 Netflix
    type: select
    proxies:
      - ✈️ 手动切换

  - name: 🪟 Microsoft
    type: select
    proxies:
      - 🌠 节点选择
      - ✈️ 手动切换
      - DIRECT

  - name: 🛖 国际流媒体
    type: select
    proxies:
      - 🌠 节点选择
      - ✈️ 手动切换

  - name: 🐳 漏网の鱼
    type: select
    proxies:
      - 🌠 节点选择
      - ✈️ 手动切换
      - DIRECT

  - name: 🛫 香港专线
    type: fallback
    proxies:
      - 🐳 漏网の鱼
    url: https://www.gstatic.com/generate_204
    interval: 97
    lazy: false

  - name: 🌺 日本专线
    type: fallback
    proxies:
      - 🐳 漏网の鱼
    url: https://www.gstatic.com/generate_204
    interval: 127
    lazy: false

  - name: 🧊 新加坡专线
    type: fallback
    proxies:
      - 🐳 漏网の鱼
    url: https://www.gstatic.com/generate_204
    interval: 177
    lazy: false

  - name: ⛳ 美国专线
    type: fallback
    proxies:
      - 🐳 漏网の鱼
    url: https://www.gstatic.com/generate_204
    interval: 233
    lazy: false

